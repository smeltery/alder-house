---
import "../styles/global.css";
import "../styles/chrome.css";
import "../styles/editorial.css";
import "../styles/transitions.css";
import "../styles/brand.css";
import "../styles/pages.css";
import "../styles/gallery.css";
import Search from "../components/Search.astro";
import "../styles/search.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  inquiry?: string;
  title?: string;
  description?: string;
}
const {
  inquiry = "/inquire/",
  title = "Alder House — Portrait & Lifestyle Photography",
  description = "An imagined photography studio for portraits, families, personal brands, and life’s celebrations.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const identity = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Alder House",
  description:
    "A fictional photography studio website demonstration by smeltery. No bookings or inquiry submissions are accepted.",
  url: Astro.site?.href,
  creator: {
    "@type": "Organization",
    name: "smeltery",
    url: "https://github.com/smeltery",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="is-agentic-site-type" content="business" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(identity).replaceAll("<", "\\u003c")}
    />
    <meta name="theme-color" content="#343d30" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={
        Astro.site
          ? new URL("/brand/og-image.png", Astro.site).href
          : "/brand/og-image.png"
      }
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Alder House — portraits that feel like you"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header inquiry={inquiry} />
    <main id="main">
      <slot />
    </main>
    <Footer inquiry={inquiry} />
    <Search inquiry={inquiry} />
    <script>
      import "../client/transitions";
    </script>
  </body>
</html>
