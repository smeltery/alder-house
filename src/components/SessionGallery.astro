---
import { ChevronLeft, ChevronRight, X, Expand } from "lucide-astro";
import type { Photograph } from "../lib/demo";
interface Props {
  images: Photograph[];
  title: string;
}
const { images, title } = Astro.props;
---

<section
  class="session-gallery wrap"
  aria-labelledby="gallery-heading"
  id="photographs"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">THE FULL COLLECTION / {images.length} PHOTOGRAPHS</p>
      <h2 id="gallery-heading">Stay a little longer.</h2>
    </div>
    <p>Open a photograph to browse the collection.</p>
  </div>
  <div class="photo-sequence">
    {images.map((photo, index) => (
      <a
        href={photo.src}
        data-gallery-photo
        aria-label={`Open photograph ${index + 1}: ${photo.alt}`}
      >
        <img
          src={photo.src}
          alt={photo.alt}
          width="1200"
          height="1500"
          loading="lazy"
          decoding="async"
        />
        <span>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <Expand size={18} aria-hidden="true" />
        </span>
      </a>
    ))}
  </div>
</section>
<dialog id="photo-viewer" aria-label={`${title} photo viewer`}>
  <div class="viewer-toolbar">
    <span>{title}</span>
    <button type="button" data-close aria-label="Close photo viewer">
      <X size={24} />
    </button>
  </div>
  <figure>
    <img alt="" draggable="false" />
    <figcaption aria-live="polite"></figcaption>
  </figure>
  <p data-image-error hidden>
    This photograph could not load. Try the next image or{" "}
    <a href="">open the original</a>.
  </p>
  <div class="viewer-controls">
    <button type="button" data-step="-1" aria-label="Previous photograph">
      <ChevronLeft size={24} />
    </button>
    <span data-count aria-live="polite"></span>
    <button type="button" data-step="1" aria-label="Next photograph">
      <ChevronRight size={24} />
    </button>
  </div>
</dialog>
<script>
  import "../client/gallery";
</script>
