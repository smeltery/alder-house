---
import {
  X,
  Search,
  FileText,
  Compass,
  MessageCircle,
  ChevronRight,
} from "lucide-astro";
import { sessions } from "../lib/demo";
import { toolCatalog } from "../lib/tool-catalog";
import { getContent } from "../lib/content";
interface Props {
  inquiry?: string;
}
const { inquiry = "/inquire/" } = Astro.props;
const { albums } = await getContent();
const groups = [
  {
    label: "Pages",
    icon: FileText,
    links: [
      ["Home", "/", "Portraits that feel like you"],
      ["Portfolio", "/work/", "People, places, and everyday stories"],
      ["Sessions", "/experience/", "Find the right photography experience"],
      ["The studio", "/about/", "Our perspective, your personality"],
      ["Planning tools", "/tools/", "A little help getting started"],
      ["Brand resources", "/brand/", "The Alder House visual identity"],
      ["Photography credits", "/credits/", "Meet the original image creators"],
      ["Privacy", "/privacy/", "How this concept website works"],
      ...sessions.map((s) => [
        s.name,
        `/sessions/${s.id}/`,
        "Explore this session",
      ]),
      ...albums.map((a) => [
        a.title,
        `/work/${a.slug}/`,
        `${a.category} · ${a.location}`,
      ]),
    ],
  },
  {
    label: "Tools",
    icon: Compass,
    links: toolCatalog.map((t) => [t.title, `/tools/${t.slug}/`, t.text]),
  },
  {
    label: "Contact",
    icon: MessageCircle,
    links: [
      ["Start a conversation", inquiry, "Tell us about your people and plans"],
    ],
  },
];
---

<dialog id="site-search" aria-labelledby="search-title">
  <div class="search-heading">
    <h2 id="search-title">Find your way.</h2>
    <button type="button" aria-label="Close search">
      <X size={22} aria-hidden="true" />
    </button>
  </div>
  <label class="search-label" for="search-query">
    Search pages, sessions, and planning tools
  </label>
  <div class="search-input">
    <Search size={22} aria-hidden="true" />
    <input
      id="search-query"
      type="search"
      placeholder="Search Alder House…"
      autocomplete="off"
      autofocus
    />
  </div>
  <div class="search-filters" role="group" aria-label="Filter search results">
    {["All", ...groups.map((group) => group.label)].map((label) => (
      <button type="button" aria-pressed={label === "All" ? "true" : "false"}>
        {label}
      </button>
    ))}
  </div>
  <nav aria-label="Search results">
    {groups.map((group) => (
      <section data-search-group={group.label} aria-label={group.label}>
        <h3>{group.label}</h3>
        {group.links.map(([label, href, description]) => (
          <a href={href} data-category={group.label}>
            <group.icon size={21} aria-hidden="true" />
            <span>
              {label}
              <small>{description}</small>
            </span>
            <ChevronRight size={16} aria-hidden="true" />
          </a>
        ))}
      </section>
    ))}
  </nav>
  <footer class="search-footer">
    <p id="search-status" role="status"></p>
    <p>
      <kbd>↑</kbd> <kbd>↓</kbd> Navigate <kbd>↵</kbd> Open <kbd>Esc</kbd> Close
    </p>
  </footer>
</dialog>
<script>
  import "../client/search";
</script>
