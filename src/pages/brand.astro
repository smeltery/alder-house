---
import { Download } from "lucide-astro";
import Layout from "../layouts/Layout.astro";
import Closing from "../components/Closing.astro";
const assets = [
  ["Primary signature", "/brand/logo.svg", false],
  ["Signature on dark", "/brand/logo-light.svg", true],
  ["The arch monogram", "/brand/mark.svg", false],
  ["White browser icon", "/favicon.svg", false],
] as const;
const palette = [
  ["Alder green", "#303A2D"],
  ["Warm ivory", "#F6F3EC"],
  ["Soft sage", "#E5E7DA"],
  ["Quiet stone", "#62665B"],
];
---

<Layout
  title="Brand resources — Alder House"
  description="Alder House logo downloads, colors, typography, photography direction, and brand guidance."
>
  <section class="page-intro wrap">
    <p class="eyebrow">ALDER HOUSE / BRAND RESOURCES</p>
    <h1>
      A familiar feeling.
      <br />
      <em>A distinct signature.</em>
    </h1>
    <p class="lead">
      A quiet, considered identity for photographs full of personality. These
      resources keep Alder House recognizable wherever the story goes.
    </p>
    <a class="button" href="/brand/logo.svg" download>
      <Download size={18} aria-hidden="true" /> Download the primary logo
    </a>
  </section>
  <section class="brand-assets wrap" aria-label="Downloadable artwork">
    {assets.map(([name, src, dark]) => (
      <figure>
        <div class:list={["brand-preview", { dark }]}>
          <img src={src} width="430" height="110" alt={name} />
        </div>
        <figcaption>
          <strong>{name}</strong>
          <a class="text-link" href={src} download>
            <Download size={16} aria-hidden="true" /> SVG
          </a>
        </figcaption>
      </figure>
    ))}
  </section>
  <section class="social-assets wrap">
    <div>
      <p class="eyebrow">READY TO SHARE</p>
      <h2>A warm introduction.</h2>
      <p>
        Our social preview pairs the studio signature with the coastal edit. Use
        the white favicon for browser tabs and the touch icon for saved
        shortcuts.
      </p>
      <div class="hero-actions">
        <a class="text-link" href="/brand/og-image.png" download>
          <Download size={16} aria-hidden="true" /> Social image · PNG
        </a>
        <a class="text-link" href="/favicon.svg" download>
          <Download size={16} aria-hidden="true" /> White favicon · SVG
        </a>
      </div>
      <p>
        <small>Social image: 1200 × 630 pixels.</small>
      </p>
    </div>
    <img
      src="/brand/og-image.png"
      width="1200"
      height="630"
      alt="Alder House social preview with the studio signature and a family on the coast"
      loading="lazy"
    />
  </section>
  <section class="detail-section wrap">
    <div>
      <p class="eyebrow">THE MARK</p>
      <h2>
        An open door.
        <br />
        <em>A personal view.</em>
      </h2>
    </div>
    <div>
      <p>
        The arch suggests a welcoming house; the geometric AH monogram gives it
        a clear signature. Use the full studio name when introducing Alder
        House. Use the compact monogram where the name is already understood.
      </p>
      <p>
        Leave at least half the mark’s width as clear space. Keep the arch mark
        at least 32 pixels high and the full signature at least 220 pixels wide.
        The simplified favicon is designed for smaller browser sizes.
      </p>
      <a class="text-link" href="/apple-touch-icon.png" download>
        Download the touch icon
      </a>
    </div>
  </section>
  <section class="preparation">
    <div class="wrap">
      <p class="eyebrow">THE PALETTE</p>
      <h2>
        Grounded in green.
        <br />
        <em>Room to breathe.</em>
      </h2>
      <div class="swatches">
        {palette.map(([name, color]) => (
          <div>
            <span style={`background:${color}`}></span>
            <strong>{name}</strong>
            <code>{color}</code>
          </div>
        ))}
      </div>
      <p>
        Use green on ivory for primary text and ivory on green for invitations.
        Sage is a supporting surface, not a small-text color.
      </p>
    </div>
  </section>
  <section class="detail-section wrap">
    <div>
      <p class="eyebrow">TYPE & VOICE</p>
      <h2>
        Thoughtful.
        <br />
        <em>Never distant.</em>
      </h2>
    </div>
    <div>
      <h3>Portraits that feel like you.</h3>
      <p>
        Italiana brings character to headlines. DM Sans keeps body copy,
        navigation, and forms easy to read. Downloadable signatures use Georgia
        and Arial fallbacks for portability; keep the supplied proportions
        intact.
      </p>
      <p>
        Write warmly and directly. Explain what happens next. Make room for
        different families, personalities, and businesses. Avoid invented
        testimonials, guarantees, or urgency.
      </p>
    </div>
  </section>
  <section class="preparation">
    <div class="wrap">
      <p class="eyebrow">PHOTOGRAPHY & CONSISTENCY</p>
      <h2>
        Classic style.
        <br />
        <em>Natural connection.</em>
      </h2>
      <div class="preparation-grid">
        <article>
          <h3>Choose real feeling</h3>
          <p>
            Look for easy expressions, clean natural light, and a sense of
            place. Favor crisp cotton, tailored layers, soft colors, and relaxed
            preppy styling.
          </p>
        </article>
        <article>
          <h3>Protect the signature</h3>
          <p>
            Do not stretch, rotate, add shadows, or place the logo over busy
            images. Use the supplied light artwork on dark backgrounds and
            retain the original colors.
          </p>
        </article>
        <article>
          <h3>Credit the work</h3>
          <p>
            Stock images illustrate this fictional studio and must not be
            presented as client commissions. Photography and icon licenses
            remain separate from the project’s code license.
          </p>
        </article>
      </div>
      <a class="text-link" href="/credits/">
        See photography and icon credits
      </a>
    </div>
  </section>
  <Closing />
</Layout>
