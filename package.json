{
  "name": "alder-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4398 --ignore-lock",
    "build": "astro build && bun scripts/discovery.ts",
    "preview": "astro preview --host 127.0.0.1 --ignore-lock",
    "studio": "sanity dev --port 3333",
    "studio:build": "sanity build dist/studio --yes",
    "check": "prettier --check . && markdownlint-cli2 && bun scripts/validate.ts && astro check && tsc --noEmit",
    "verify": "bash scripts/check.sh",
    "test": "bun test scripts/discovery.test.ts && playwright test",
    "format": "prettier --write .",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@sanity/client": "^8.11.0",
    "@vercel/functions": "^3.10.3",
    "astro": "^7.4.2",
    "lucide-astro": "^0.556.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.20.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/turndown": "^5.0.6",
    "happy-dom": "^21.0.4",
    "markdownlint-cli2": "^0.24.0",
    "mermaid": "^12.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "1.1.2",
    "turndown": "^7.2.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
